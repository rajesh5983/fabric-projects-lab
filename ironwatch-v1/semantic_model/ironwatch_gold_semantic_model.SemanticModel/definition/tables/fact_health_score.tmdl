table fact_health_score
	lineageTag: baa2b65f-a7c8-412e-af1f-314a6aae59e0

	measure 'Health Score' = AVERAGE ( fact_health_score[health_score] )
		formatString: 0.0
		lineageTag: 3722417e-b64f-41ca-925f-55b9b5924ed2

	measure 'Fleet at Risk' = ```
			COUNTROWS (
			    FILTER (
			        VALUES ( dim_asset[asset_id] ),
			        [Health Score] < 60
			    )
			)
			```
		formatString: 0
		lineageTag: 4af8a3b0-3b4e-48d6-8fe8-4c92afef8dcb

	measure 'Avg Days Since Service' = AVERAGE ( fact_health_score[days_since_service] )
		formatString: 0.0
		lineageTag: eda291a4-2a9e-4c64-992d-60e4f2e8ea08

