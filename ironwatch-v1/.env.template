# IronWatch v1 — Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ModernAnalyticsLab Azure
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_TENANT_ID=<your-tenant-id>
AZURE_KEY_VAULT_URL=https://mal-kv-shared.vault.azure.net/

# Service Principals (values stored in Key Vault — never here)
SP_FABRIC_MAL_CLIENT_ID=<from-key-vault>
SP_IRONWATCH_DEV_CLIENT_ID=<from-key-vault>

# Fabric
FABRIC_CAPACITY_NAME=fabricf2sandbox
FABRIC_WORKSPACE_DEV=ModernAnalyticsLab-DEV
FABRIC_LAKEHOUSE_BRONZE=ironwatch_bronze
FABRIC_LAKEHOUSE_SILVER=ironwatch_silver
FABRIC_WAREHOUSE_GOLD=ironwatch_gold

# dbt (transform/ironwatch_gold) — SQL endpoint hostname is not a secret,
# safe to store directly. SP_IRONWATCH_DEV_CLIENT_SECRET is intentionally
# NOT listed here — see transform/ironwatch_gold/profiles.yml for how it's
# resolved from mal-kv-shared at runtime instead.
IRONWATCH_GOLD_SQL_ENDPOINT=<warehouse-sql-endpoint-hostname-from-fabric-portal>

# Synthetic data
SYNTHETIC_OUTPUT_PATH=./synthetic_data/output/
SYNTHETIC_EQUIPMENT_COUNT=50
SYNTHETIC_DAYS=90
